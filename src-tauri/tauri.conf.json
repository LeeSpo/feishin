{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Feishin",
  "version": "1.17.0",
  "identifier": "org.leespo.feishin",
  "build": {
    "beforeDevCommand": "bun run tauri:web:dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run build:web",
    "frontendDist": "../out/web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Feishin",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    },
    "macOSPrivateApi": false
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/henry.w@example.net",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "digestAlgorithm": "sha256"
    }
  },
  "plugins": {}
}
